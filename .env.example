# Local development template. Keep real secrets in .env or your hosting provider's secret store.
APP_NAME=Smart Form Builder API
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=replace-with-a-random-local-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_form_builder
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:3000,http://localhost:19007,http://127.0.0.1:19006,http://127.0.0.1:8081,http://127.0.0.1:3000,http://127.0.0.1:19007

UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
EMAIL_OTP_EXPIRE_MINUTES=10

GOOGLE_CLIENT_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
