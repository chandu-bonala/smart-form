# SmartForm Frontend Configuration

# API Configuration
# Change this to match your backend server
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# For production, change to:
# EXPO_PUBLIC_API_BASE_URL=https://your-production-url.com

# API Version
EXPO_PUBLIC_API_VERSION=/api/v1

# Environment
EXPO_PUBLIC_ENVIRONMENT=development
# For production: EXPO_PUBLIC_ENVIRONMENT=production

# App Settings
EXPO_PUBLIC_APP_NAME=SmartForm
EXPO_PUBLIC_DEBUG=true
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
